{
  "manifest_version": 3,
  "name": "Multi-Job JD Collector",
  "version": "1.1.0",
  "description": "Extract structured job data from LinkedIn and Naukri job pages.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://www.naukri.com/*"
  ],
  "action": {
    "default_title": "Job Collector",
    "default_popup": "popup.html"
  }
}